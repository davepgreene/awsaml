{
  "name": "awsaml",
  "version": "4.5.0",
  "description": "Periodically refreshes AWS access keys",
  "license": "MIT",
  "contributors": [
    "Opal Mitchell",
    "Dave Greene",
    "Marguerite Martinez",
    "Andrea Nguyen"
  ],
  "thanks": [
    "Tristan Harward"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/rapid7/awsaml.git"
  },
  "bugs": {
    "url": "https://github.com/rapid7/awsaml/issues"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "packageManager": "yarn@4.12.0",
  "scripts": {
    "electron": "electron src/main/index.js",
    "electron-dev": "NODE_ENV=development ELECTRON_START_URL=http://localhost:3000 electron src/main/index.js",
    "react-start": "vite",
    "react-build": "vite build",
    "test": "jest",
    "lint": "eslint '*.js' '*.mjs' 'src/**/*.js' 'src/**/*.ts' 'src/**/*.tsx' 'test/**/*.js'",
    "report": "coveralls < ./coverage/lcov.info",
    "build": "node build.js",
    "show-appcast-checkpoint": "curl --compressed --location --user-agent 'Mozilla/5.0 (Macintosh; Intel Mac OS X 10_9_2) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/33.0.1750.152 Safari/537.36' 'https://github.com/rapid7/awsaml/releases.atom' | /usr/bin/sed 's|<pubDate>[^<]*</pubDate>||g' | shasum --algorithm 256",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "clean": "rm -rf out && rm -rf build"
  },
  "homepage": "./",
  "main": "src/main/index.js",
  "dependencies": {
    "@aws-sdk/client-sts": "^3.1000.0",
    "@node-saml/passport-saml": "^5.1.0",
    "@xmldom/xmldom": "^0.8.11",
    "body-parser": "^2.2.2",
    "electron-log": "^5.4.3",
    "electron-squirrel-startup": "^1.0.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "ini": "^6.0.0",
    "morgan": "^1.10.1",
    "passport": "^0.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "stylis": "^4.3.6",
    "update-electron-app": "^3.1.2",
    "uuid": "^13.0.0",
    "xpath.js": "^1.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/core": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-webpack": "^7.11.1",
    "@electron-forge/publisher-github": "^7.11.1",
    "@electron/get": "^4.0.2",
    "@electron/rebuild": "^4.0.3",
    "@eslint/compat": "^2.0.2",
    "@eslint/js": "^10.0.1",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.2.0",
    "@popperjs/core": "^2.11.8",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitejs/plugin-react": "^5.1.4",
    "babel-jest": "^30.2.0",
    "bootstrap": "^5.3.8",
    "coveralls": "^3.1.1",
    "electron": "^40.6.1",
    "electron-packager": "^17.1.2",
    "eslint": "^10.0.2",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.15.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "glob": "^13.0.6",
    "globals": "^17.4.0",
    "history": "^5.3.0",
    "immutability-helper": "^3.1.1",
    "jest": "^30.2.0",
    "jest-junit": "^16.0.0",
    "prismjs": "^1.30.0",
    "prop-types": "^15.8.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-is": "^19.2.4",
    "react-router": "^7.13.1",
    "react-router-dom": "^7.13.1",
    "reactstrap": "^9.2.3",
    "should": "^13.2.3",
    "styled-components": "^6.3.11",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "browserslist": {
    "production": [
      "last 1 electron version"
    ],
    "development": [
      "last 1 electron version"
    ]
  }
}
