{
  "name": "awsaml",
  "version": "4.5.0",
  "description": "Periodically refreshes AWS access keys",
  "license": "MIT",
  "contributors": [
    "Opal Mitchell",
    "Dave Greene",
    "Marguerite Martinez",
    "Andrea Nguyen"
  ],
  "thanks": [
    "Tristan Harward"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/rapid7/awsaml.git"
  },
  "bugs": {
    "url": "https://github.com/rapid7/awsaml/issues"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "packageManager": "yarn@4.12.0",
  "scripts": {
    "electron": "electron src/main/index.js",
    "electron-dev": "NODE_ENV=development ELECTRON_START_URL=http://localhost:3000 electron src/main/index.js",
    "react-start": "vite",
    "react-build": "vite build",
    "test": "jest",
    "lint": "eslint '*.js' 'src/**/*.js' 'src/**/*.jsx' 'test/**/*.js'",
    "report": "coveralls < ./coverage/lcov.info",
    "build": "node build.js",
    "show-appcast-checkpoint": "curl --compressed --location --user-agent 'Mozilla/5.0 (Macintosh; Intel Mac OS X 10_9_2) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/33.0.1750.152 Safari/537.36' 'https://github.com/rapid7/awsaml/releases.atom' | /usr/bin/sed 's|<pubDate>[^<]*</pubDate>||g' | shasum --algorithm 256",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "clean": "rm -rf out && rm -rf build"
  },
  "homepage": "./",
  "main": "src/main/index.js",
  "dependencies": {
    "@aws-sdk/client-sts": "^3.1000.0",
    "@node-saml/passport-saml": "^5.1.0",
    "@xmldom/xmldom": "^0.8.11",
    "body-parser": "^1.20.4",
    "electron-log": "^5.4.3",
    "electron-squirrel-startup": "^1.0.1",
    "express": "^4.22.1",
    "express-session": "^1.19.0",
    "ini": "^4.1.3",
    "morgan": "^1.10.1",
    "passport": "^0.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stylis": "^4.3.6",
    "update-electron-app": "^3.1.2",
    "uuid": "^10.0.0",
    "xpath.js": "^1.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/eslint-parser": "^7.28.6",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/core": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-webpack": "^7.11.1",
    "@electron-forge/publisher-github": "^7.11.1",
    "@electron/get": "^3.1.0",
    "@electron/rebuild": "^3.7.2",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-regular-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.6",
    "@popperjs/core": "^2.11.8",
    "@vitejs/plugin-react": "^4.7.0",
    "babel-jest": "^29.7.0",
    "bootstrap": "^5.3.8",
    "coveralls": "^3.1.1",
    "electron": "^31.7.7",
    "electron-packager": "^17.1.2",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^28.14.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "glob": "^11.1.0",
    "history": "^5.3.0",
    "immutability-helper": "^3.1.1",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "prismjs": "^1.30.0",
    "prop-types": "^15.8.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-is": "^18.3.1",
    "react-router": "^6.30.3",
    "react-router-dom": "^6.30.3",
    "reactstrap": "^9.2.3",
    "should": "^13.2.3",
    "styled-components": "^6.3.11",
    "typescript": "^4.9.5",
    "vite": "^5.4.21"
  },
  "browserslist": {
    "production": [
      "last 1 electron version"
    ],
    "development": [
      "last 1 electron version"
    ]
  }
}
